# Generated by devops.aap_ops.compliance_baseline - profile {{ _profile }}
$ErrorActionPreference = 'Stop'
$tmp = Join-Path $env:TEMP ("aapops_secpol_{0}.inf" -f [guid]::NewGuid())
secedit /export /cfg $tmp /areas SECURITYPOLICY | Out-Null
$sec = @{}
Get-Content $tmp | ForEach-Object { if ($_ -match '^\s*([^=\[]+?)\s*=\s*(.*)$') { $sec[$Matches[1]] = $Matches[2].Trim('"') } }
Remove-Item $tmp -Force -ErrorAction SilentlyContinue
$audit = @{}
auditpol /get /category:* /r | ConvertFrom-Csv | ForEach-Object { $audit[$_.Subcategory] = $_.'Inclusion Setting' }
function Reg([string]$Path, [string]$Name) { (Get-ItemProperty -LiteralPath $Path -Name $Name -ErrorAction SilentlyContinue).$Name }
$r = [ordered]@{}
{% for c in _controls %}
try { $r['{{ c.id }}'] = [bool](& { {{ c.check }} }) } catch { $r['{{ c.id }}'] = $false }
{% endfor %}
$r | ConvertTo-Json -Compress
