#!/bin/bash
# Generated by devops.aap_ops.compliance_baseline - profile {{ _profile }}
# Prints one line per control: ID|rc  (rc 0 = compliant)
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
{% for c in _controls %}
timeout {{ compliance_baseline_check_timeout }} bash -c {{ c.check | quote }} >/dev/null 2>&1; echo "{{ c.id }}|$?"
{% endfor %}
